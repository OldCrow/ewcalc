*.csproj       text eol=crlf
*.props        text eol=crlf
*.targets      text eol=crlf
*.filters      text eol=crlf
*.appxmanifest text eol=crlf
*.manifest     text eol=crlf
*.resx         text eol=crlf
*.ps1          text eol=crlf
*.cmd          text eol=crlf
