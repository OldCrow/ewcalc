<Page
    x:Class="EwCalc.Views.DetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EwCalc.Helpers"
    xmlns:local="using:EwCalc.Views">

    <Page.Resources>
        <helpers:FieldErrorToBrushConverter x:Key="FieldErrorToBrush" />
        <helpers:FieldErrorToTooltipConverter x:Key="FieldErrorToTooltip" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="8">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Detection" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Required SNR (Albersheim / Shnidman) · Swerling fluctuation loss · Scan timing · False-alarm rate"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Click="CopyResultsButton_Click"
                        AutomationProperties.Name="Copy results to clipboard"
                        ToolTipService.ToolTip="Copy all results to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Copy results" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="DETECTION STATISTICS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="PdBox" Header="Probability of detection"
                               AutomationProperties.Name="Probability of detection"
                               ToolTipService.ToolTip="Single-scan probability of detection — Shnidman's equation is valid for 0.1 to 0.99"
                               Value="{x:Bind ViewModel.DefaultPd, Mode=OneTime}"
                               Minimum="0.1" Maximum="0.99"
                               SpinButtonPlacementMode="Compact" SmallChange="0.01"
                               BorderBrush="{x:Bind ViewModel.PdError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="PdBox_ValueChanged" />
                    <NumberBox x:Name="PfaExponentBox" Header="Pfa exponent (10^x)"
                               AutomationProperties.Name="False-alarm probability exponent"
                               ToolTipService.ToolTip="False-alarm probability exponent x, Pfa = 10^x — e.g. −6 for Pfa = 10⁻⁶"
                               Value="{x:Bind ViewModel.DefaultPfaExponent, Mode=OneTime}"
                               Minimum="-9" Maximum="-3"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.PfaExponentError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="PfaExponentBox_ValueChanged" />
                    <NumberBox x:Name="NumPulsesBox" Header="Pulses integrated"
                               AutomationProperties.Name="Pulses integrated"
                               ToolTipService.ToolTip="Pulses noncoherently integrated — Shnidman's equation is valid for 1 to 100"
                               Value="{x:Bind ViewModel.DefaultNumPulses, Mode=OneTime}"
                               Minimum="1" Maximum="100"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.NumPulsesError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="NumPulsesBox_ValueChanged" />
                    <NumberBox x:Name="SwerlingCaseBox" Header="Swerling case (0–4)"
                               AutomationProperties.Name="Swerling case"
                               ToolTipService.ToolTip="Target fluctuation model: 0 nonfluctuating, 1–4 the Swerling cases"
                               Value="{x:Bind ViewModel.DefaultSwerlingCase, Mode=OneTime}"
                               Minimum="0" Maximum="4"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.SwerlingCaseError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="SwerlingCaseBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="SCAN TIMING" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="BeamwidthBox" Header="Azimuth beamwidth (deg)"
                               AutomationProperties.Name="Azimuth beamwidth (degrees)"
                               ToolTipService.ToolTip="Antenna 3 dB azimuth beamwidth"
                               Value="{x:Bind ViewModel.DefaultBeamwidth, Mode=OneTime}"
                               Minimum="0.1" Maximum="45"
                               SpinButtonPlacementMode="Compact" SmallChange="0.5"
                               BorderBrush="{x:Bind ViewModel.BeamwidthError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="BeamwidthBox_ValueChanged" />
                    <NumberBox x:Name="ScanRateBox" Header="Scan rate (deg/s)"
                               AutomationProperties.Name="Scan rate (degrees per second)"
                               ToolTipService.ToolTip="Antenna rotation rate — 36 deg/s is a 10 s rotation"
                               Value="{x:Bind ViewModel.DefaultScanRate, Mode=OneTime}"
                               Minimum="1" Maximum="720"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.ScanRateError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="ScanRateBox_ValueChanged" />
                    <NumberBox x:Name="PrfBox" Header="PRF (Hz)"
                               AutomationProperties.Name="PRF (Hz)"
                               ToolTipService.ToolTip="Pulse repetition frequency"
                               Value="{x:Bind ViewModel.DefaultPrf, Mode=OneTime}"
                               Minimum="10" Maximum="1000000"
                               SpinButtonPlacementMode="Compact" SmallChange="10"
                               BorderBrush="{x:Bind ViewModel.PrfError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="PrfBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="FALSE-ALARM RATE" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="BandwidthBox" Header="Noise bandwidth (MHz)"
                               AutomationProperties.Name="Noise bandwidth (MHz)"
                               ToolTipService.ToolTip="Receiver noise bandwidth — with Pfa, sets the false-alarm rate"
                               Value="{x:Bind ViewModel.DefaultBandwidth, Mode=OneTime}"
                               Minimum="0.001" Maximum="10000"
                               SpinButtonPlacementMode="Compact" SmallChange="0.1"
                               BorderBrush="{x:Bind ViewModel.BandwidthError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="BandwidthBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="REQUIRED SNR" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource ResultCardStyle}">
                <StackPanel Spacing="0">
                    <local:ResultRow Label="Required SNR (Shnidman)"        Value="{x:Bind ViewModel.RequiredSnr,           Mode=OneWay}" IsHighlighted="True" />
                    <local:ResultRow Label="Required SNR (Albersheim, Sw0)" Value="{x:Bind ViewModel.RequiredSnrAlbersheim, Mode=OneWay}" />
                    <local:ResultRow Label="Fluctuation loss"               Value="{x:Bind ViewModel.FluctuationLoss,       Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock Text="SCAN &amp; FALSE ALARMS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource ResultCardStyle}">
                <StackPanel Spacing="0">
                    <local:ResultRow Label="Dwell time"       Value="{x:Bind ViewModel.DwellTime,   Mode=OneWay}" />
                    <local:ResultRow Label="Hits per scan"    Value="{x:Bind ViewModel.HitsPerScan, Mode=OneWay}" />
                    <local:ResultRow Label="False-alarm rate" Value="{x:Bind ViewModel.Far,         Mode=OneWay}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
