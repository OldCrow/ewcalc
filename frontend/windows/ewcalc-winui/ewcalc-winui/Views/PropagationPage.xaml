<Page
    x:Class="EwCalc.Views.PropagationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EwCalc.Helpers"
    xmlns:local="using:EwCalc.Views"
    xmlns:vm="using:EwCalc.ViewModels">

    <Page.Resources>
        <helpers:FieldErrorToBrushConverter x:Key="FieldErrorToBrush" />
        <helpers:FieldErrorToTooltipConverter x:Key="FieldErrorToTooltip" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="8">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Propagation"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Free-space path loss · 2-ray ground reflection · Fresnel zone"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Click="CopyResultsButton_Click"
                        AutomationProperties.Name="Copy results to clipboard"
                        ToolTipService.ToolTip="Copy all results to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Copy results" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="INPUTS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <!-- Minimum/Maximum are overridden at construction by PageHelper.Setup()
                         which sets exact double values. XAML values are parsed as float32
                         and are never visible to the user. -->
                    <NumberBox x:Name="DistanceBox"
                               Header="Distance (km)"
                               AutomationProperties.Name="Distance (km)"
                               Value="{x:Bind ViewModel.DefaultDistance, Mode=OneTime}"
                               Minimum="0.01" Maximum="10000"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.DistanceError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="DistanceBox_ValueChanged">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind ViewModel.DistanceError, Mode=OneWay,
                                         Converter={StaticResource FieldErrorToTooltip},
                                         ConverterParameter='Total path length between transmitter and receiver'}" />
                        </ToolTipService.ToolTip>
                    </NumberBox>
                    <NumberBox x:Name="FrequencyBox"
                               Header="Frequency (MHz)"
                               AutomationProperties.Name="Frequency (MHz)"
                               ToolTipService.ToolTip="Carrier frequency — path loss scales as f² in free space"
                               Value="{x:Bind ViewModel.DefaultFrequency, Mode=OneTime}"
                               Minimum="0.1" Maximum="100000"
                               SpinButtonPlacementMode="Compact" SmallChange="10"
                               BorderBrush="{x:Bind ViewModel.FrequencyError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="FrequencyBox_ValueChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Grid.Column="0" x:Name="TxHeightBox"
                                   Header="Tx height (m)"
                                   AutomationProperties.Name="Tx height (m)"
                                   ToolTipService.ToolTip="Transmit antenna height above ground — determines the Fresnel zone crossover distance"
                                   Value="{x:Bind ViewModel.DefaultTxHeight, Mode=OneTime}"
                                   Minimum="0.1" Maximum="100000"
                                   SpinButtonPlacementMode="Compact" SmallChange="1"
                                   BorderBrush="{x:Bind ViewModel.TxHeightError, Mode=OneWay,
                                       Converter={StaticResource FieldErrorToBrush}}"
                                   ValueChanged="TxHeightBox_ValueChanged" />
                        <NumberBox Grid.Column="1" x:Name="RxHeightBox"
                                   Header="Rx height (m)"
                                   AutomationProperties.Name="Rx height (m)"
                                   ToolTipService.ToolTip="Receive antenna height above ground — determines the Fresnel zone crossover distance"
                                   Value="{x:Bind ViewModel.DefaultRxHeight, Mode=OneTime}"
                                   Minimum="0.1" Maximum="100000"
                                   SpinButtonPlacementMode="Compact" SmallChange="1"
                                   BorderBrush="{x:Bind ViewModel.RxHeightError, Mode=OneWay,
                                       Converter={StaticResource FieldErrorToBrush}}"
                                   ValueChanged="RxHeightBox_ValueChanged" />
                    </Grid>
                    <NumberBox x:Name="ObstructionHeightBox"
                               Header="Obstruction height (m)"
                               AutomationProperties.Name="Obstruction height (m)"
                               Value="{x:Bind ViewModel.DefaultObstructionHeight, Mode=OneTime}"
                               Minimum="0" Maximum="10000"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.ObstructionHeightError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="ObstructionHeightBox_ValueChanged">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind ViewModel.ObstructionHeightError, Mode=OneWay,
                                         Converter={StaticResource FieldErrorToTooltip},
                                         ConverterParameter='Knife-edge obstacle height above flat-earth baseline at path midpoint — 0 = no obstruction'}" />
                        </ToolTipService.ToolTip>
                    </NumberBox>
                </StackPanel>
            </Border>

            <TextBlock Text="RESULTS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource ResultCardStyle}">
                <StackPanel Spacing="0">
                    <local:ResultRow Label="Regime"           Value="{x:Bind ViewModel.Regime,       Mode=OneWay}"
                                     ToolTipService.ToolTip="Propagation model in use: LOS (free-space) or 2-ray (ground reflection)" />
                    <local:ResultRow Label="Path loss"        Value="{x:Bind ViewModel.PathLoss,     Mode=OneWay}"
                                     ToolTipService.ToolTip="Applicable loss for this geometry — FSPL below the Fresnel crossover, 2-ray above it" />
                    <local:ResultRow Label="FSPL"             Value="{x:Bind ViewModel.Fspl,         Mode=OneWay}"
                                     ToolTipService.ToolTip="Free-space path loss: 32.44 + 20·log₁₀(km) + 20·log₁₀(MHz) — valid below the Fresnel zone crossover" />
                    <local:ResultRow Label="2-ray loss"       Value="{x:Bind ViewModel.TwoRayLoss,   Mode=OneWay}"
                                     ToolTipService.ToolTip="Two-ray ground-reflection loss: 120 + 40·log₁₀(km) − 20·log₁₀(h_tx) − 20·log₁₀(h_rx) — loss scales as d⁴ beyond Fresnel crossover" />
                    <local:ResultRow Label="Fresnel zone dist." Value="{x:Bind ViewModel.Fresnel,    Mode=OneWay}"
                                     ToolTipService.ToolTip="Range at which ground reflection begins to dominate: h_tx·h_rx·f / 24 000 km" />
                    <local:ResultRow Label="Earth bulge (mid)" Value="{x:Bind ViewModel.EarthBulge,       Mode=OneWay}"
                                     ToolTipService.ToolTip="Height the earth surface rises at the path midpoint under a standard k = 4/3 atmosphere" />
                    <local:ResultRow Label="Radar horizon"    Value="{x:Bind ViewModel.HorizonRange,     Mode=OneWay}"
                                     ToolTipService.ToolTip="Maximum visibility range combining both antenna heights: 4.12 × (√h_tx + √h_rx) km" />
                    <local:ResultRow Label="Diffraction loss" Value="{x:Bind ViewModel.DiffractionLoss,  Mode=OneWay}"
                                     ToolTipService.ToolTip="Knife-edge diffraction loss at path midpoint using the Fresnel diffraction parameter" />
                </StackPanel>
            </Border>

            <Expander Header="Geometry"
                      AutomationProperties.Name="Geometry diagrams"
                      ToolTipService.ToolTip="Show or hide the geometry diagrams for this page"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <Image Source="ms-appx:///Assets/Diagrams/prop-two-ray.png"
                           MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center"
                           AutomationProperties.Name="prop two ray" />
                    <Image Source="ms-appx:///Assets/Diagrams/prop-knife-edge.png"
                           MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center"
                           AutomationProperties.Name="prop knife edge" />
                    <Image Source="ms-appx:///Assets/Diagrams/prop-horizon-bulge.png"
                           MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center"
                           AutomationProperties.Name="prop horizon bulge" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
