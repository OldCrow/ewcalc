<Page
    x:Class="EwCalc.Views.ReceiverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EwCalc.Helpers"
    xmlns:vm="using:EwCalc.ViewModels"
    xmlns:local="using:EwCalc.Views">

    <Page.Resources>
        <helpers:FieldErrorToBrushConverter x:Key="FieldErrorToBrush" />
        <helpers:FieldErrorToTooltipConverter x:Key="FieldErrorToTooltip" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="8">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Receiver" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Sensitivity · Cascaded noise figure (Friis) · SFDR · Digital dynamic range"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Click="CopyResultsButton_Click"
                        AutomationProperties.Name="Copy results to clipboard"
                        ToolTipService.ToolTip="Copy all results to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Copy results" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="SENSITIVITY" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="BandwidthBox" Header="Bandwidth (MHz)"
                               AutomationProperties.Name="Bandwidth (MHz)"
                               ToolTipService.ToolTip="IF noise bandwidth — wider bandwidth raises the noise floor and degrades sensitivity"
                               Value="{x:Bind ViewModel.DefaultBandwidth, Mode=OneTime}"
                               Minimum="0.001" Maximum="10000"
                               BorderBrush="{x:Bind ViewModel.BandwidthError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="BandwidthBox_ValueChanged" />
                    <NumberBox x:Name="NoiseFigureBox" Header="Noise figure (dB)"
                               AutomationProperties.Name="Noise figure (dB)"
                               ToolTipService.ToolTip="System noise figure — NF = 0 dB is ideal (noiseless); each additional dB raises the sensitivity floor"
                               Value="{x:Bind ViewModel.DefaultNoiseFigure, Mode=OneTime}"
                               Minimum="0" Maximum="30" SmallChange="0.5"
                               BorderBrush="{x:Bind ViewModel.NoiseFigureError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="NoiseFigureBox_ValueChanged" />
                    <NumberBox x:Name="SnrBox" Header="Required SNR (dB)"
                               AutomationProperties.Name="Required SNR (dB)"
                               ToolTipService.ToolTip="Minimum pre-detection SNR for acceptable output — depends on modulation and required BER"
                               Value="{x:Bind ViewModel.DefaultRequiredSnr, Mode=OneTime}"
                               Minimum="-20" Maximum="50" SmallChange="0.5"
                               BorderBrush="{x:Bind ViewModel.RequiredSnrError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="SnrBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="DYNAMIC RANGE" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="Ip2Box" Header="IP2 (dBm)"
                               AutomationProperties.Name="IP2 (dBm)"
                               ToolTipService.ToolTip="Second-order input intercept point — sets the 2nd-order intermodulation floor"
                               Value="{x:Bind ViewModel.DefaultSecondOrderIp, Mode=OneTime}"
                               Minimum="-50" Maximum="100"
                               BorderBrush="{x:Bind ViewModel.SecondOrderIpError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="Ip2Box_ValueChanged" />
                    <NumberBox x:Name="Ip3Box" Header="IP3 (dBm)"
                               AutomationProperties.Name="IP3 (dBm)"
                               ToolTipService.ToolTip="Third-order input intercept point — sets the 3rd-order intermodulation floor; typically the tighter limit"
                               Value="{x:Bind ViewModel.DefaultThirdOrderIp, Mode=OneTime}"
                               Minimum="-50" Maximum="100"
                               BorderBrush="{x:Bind ViewModel.ThirdOrderIpError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="Ip3Box_ValueChanged" />
                    <NumberBox x:Name="AdcBitsBox" Header="ADC bits"
                               AutomationProperties.Name="ADC bits"
                               ToolTipService.ToolTip="Number of ADC quantisation bits — more bits raise the digital dynamic range and SQNR"
                               Value="{x:Bind ViewModel.DefaultAdcBits, Mode=OneTime}"
                               Minimum="1" Maximum="64" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.AdcBitsError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="AdcBitsBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="NOISE CHAIN (FRIIS CASCADE)" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}"
                    BorderBrush="{x:Bind ViewModel.StageNfError, Mode=OneWay,
                        Converter={StaticResource FieldErrorToBrush}}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="NF (dB)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Gain (dB)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ItemsRepeater x:Name="StageRepeater"
                                   ItemsSource="{x:Bind ViewModel.Stages, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:StageItemViewModel">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind IndexLabel}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <NumberBox Grid.Column="1"
                                               AutomationProperties.Name="{x:Bind NfAutomationName, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind NfAutomationName, Mode=OneWay}"
                                               Value="{x:Bind NoiseFigureDb, Mode=TwoWay}"
                                               Minimum="0" Maximum="30" SmallChange="0.5" />
                                    <NumberBox Grid.Column="2"
                                               AutomationProperties.Name="{x:Bind GainAutomationName, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind GainAutomationName, Mode=OneWay}"
                                               Value="{x:Bind GainDb, Mode=TwoWay}"
                                               Minimum="-60" Maximum="60" SmallChange="1" />
                                    <Button Grid.Column="3" Content="✕"
                                            AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneWay}"
                                            VerticalAlignment="Center" Padding="4"
                                            Command="{x:Bind RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button Content="+ Add stage"
                            AutomationProperties.Name="Add stage"
                            Command="{x:Bind ViewModel.AddStageCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="RESULTS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource ResultCardStyle}">
                <StackPanel Spacing="0">
                    <local:ResultRow Label="Sensitivity"    Value="{x:Bind ViewModel.Sensitivity,    Mode=OneWay}"
                                     ToolTipService.ToolTip="Minimum detectable signal: −114 + 10·log₁₀(BW) + NF + SNR (dBm)" />
                    <local:ResultRow Label="Cascaded NF"    Value="{x:Bind ViewModel.CascadedNf,     Mode=OneWay}"
                                     ToolTipService.ToolTip="System noise figure from the Friis formula across the stage chain — front-end stage dominates" />
                    <local:ResultRow Label="Sys. noise temp" Value="{x:Bind ViewModel.SystemNoiseTemp, Mode=OneWay}"
                                     ToolTipService.ToolTip="Equivalent noise temperature: Tₑ = (NFₗᵢₙ − 1) × 290 K" />
                    <local:ResultRow Label="Sys. NF equiv."  Value="{x:Bind ViewModel.SystemNf,       Mode=OneWay}"
                                     ToolTipService.ToolTip="System NF re-derived from system noise temperature — confirms the round-trip conversion" />
                    <local:ResultRow Label="SFDR (2nd)"     Value="{x:Bind ViewModel.Sfdr2,          Mode=OneWay}"
                                     ToolTipService.ToolTip="2nd-order spurious-free dynamic range: ½ × (IIP2 − sensitivity)" />
                    <local:ResultRow Label="SFDR (3rd)"     Value="{x:Bind ViewModel.Sfdr3,          Mode=OneWay}"
                                     ToolTipService.ToolTip="3rd-order spurious-free dynamic range: ⅔ × (IIP3 − sensitivity) — usually the binding constraint" />
                    <local:ResultRow Label="Digital DR"     Value="{x:Bind ViewModel.DigitalDr,      Mode=OneWay}"
                                     ToolTipService.ToolTip="ADC full-scale-to-LSB level ratio: 20·log₁₀(2ᴺ) ≈ 6.02·N dB" />
                    <local:ResultRow Label="SQNR"           Value="{x:Bind ViewModel.DigitalSqnr,    Mode=OneWay}"
                                     ToolTipService.ToolTip="Quantisation SNR of a full-scale sine: 6.02·N + 1.76 dB — the DR plus the sine's 1.76 dB" />
                </StackPanel>
            </Border>

            <Expander Header="Geometry"
                      AutomationProperties.Name="Geometry diagrams"
                      ToolTipService.ToolTip="Show or hide the geometry diagrams for this page"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <Image Source="ms-appx:///Assets/Diagrams/receiver-cascade.png"
                           MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center"
                           AutomationProperties.Name="receiver cascade" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
