<Page
    x:Class="EwCalc.Views.AntennaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EwCalc.Helpers"
    xmlns:local="using:EwCalc.Views">

    <Page.Resources>
        <helpers:FieldErrorToBrushConverter x:Key="FieldErrorToBrush" />
        <helpers:FieldErrorToTooltipConverter x:Key="FieldErrorToTooltip" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="8">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Antenna" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="ERP · Beamwidth · Gain · Wavelength"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Click="CopyResultsButton_Click"
                        AutomationProperties.Name="Copy results to clipboard"
                        ToolTipService.ToolTip="Copy all results to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Copy results" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="ANTENNA PARAMETERS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <!-- Minimum matches AntennaPresenter::set_gain's -6.35 dBi validation
                         floor (below that, beamwidth_from_gain() exceeds its valid domain
                         and returns beamwidth > 360° — see audit #1 / libew antenna.h). -->
                    <NumberBox x:Name="GainBox"        Header="Gain (dBi)"
                               AutomationProperties.Name="Gain (dBi)"
                               Value="{x:Bind ViewModel.DefaultGain, Mode=OneTime}"
                               Minimum="-6.35" Maximum="60"
                               SpinButtonPlacementMode="Compact" SmallChange="0.5"
                               BorderBrush="{x:Bind ViewModel.GainError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="GainBox_ValueChanged">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind ViewModel.GainError, Mode=OneWay,
                                         Converter={StaticResource FieldErrorToTooltip}}" />
                        </ToolTipService.ToolTip>
                    </NumberBox>
                    <NumberBox x:Name="AzBeamwidthBox" Header="Az beamwidth (deg)"
                               AutomationProperties.Name="Az beamwidth (deg)"
                               Value="{x:Bind ViewModel.DefaultAzBeamwidth, Mode=OneTime}"
                               Minimum="0.1" Maximum="360"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.AzBeamwidthError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="AzBeamwidthBox_ValueChanged" />
                    <NumberBox x:Name="ElBeamwidthBox" Header="El beamwidth (deg)"
                               AutomationProperties.Name="El beamwidth (deg)"
                               Value="{x:Bind ViewModel.DefaultElBeamwidth, Mode=OneTime}"
                               Minimum="0.1" Maximum="360"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.ElBeamwidthError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="ElBeamwidthBox_ValueChanged" />
                    <NumberBox x:Name="TxPowerBox"     Header="Tx power (dBm)"
                               AutomationProperties.Name="Tx power (dBm)"
                               Value="{x:Bind ViewModel.DefaultTxPower, Mode=OneTime}"
                               Minimum="-30" Maximum="100"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.TxPowerError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="TxPowerBox_ValueChanged" />
                    <NumberBox x:Name="FrequencyBox"   Header="Frequency (MHz)"
                               AutomationProperties.Name="Frequency (MHz)"
                               Value="{x:Bind ViewModel.DefaultFrequency, Mode=OneTime}"
                               Minimum="0.1" Maximum="100000"
                               SpinButtonPlacementMode="Compact" SmallChange="10"
                               BorderBrush="{x:Bind ViewModel.FrequencyError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="FrequencyBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="RESULTS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource ResultCardStyle}">
                <StackPanel Spacing="0">
                    <local:ResultRow Label="ERP"                 Value="{x:Bind ViewModel.Erp,               Mode=OneWay}" IsHighlighted="True" />
                    <local:ResultRow Label="Beamwidth from gain" Value="{x:Bind ViewModel.BeamwidthFromGain, Mode=OneWay}" />
                    <local:ResultRow Label="Gain from beamwidth" Value="{x:Bind ViewModel.GainFromBeamwidth, Mode=OneWay}" />
                    <local:ResultRow Label="Wavelength"          Value="{x:Bind ViewModel.Wavelength,        Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Expander Header="Geometry"
                      AutomationProperties.Name="Geometry diagrams"
                      ToolTipService.ToolTip="Show or hide the geometry diagrams for this page"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <Image Source="ms-appx:///Assets/Diagrams/antenna-beamwidth.png"
                           MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center"
                           AutomationProperties.Name="antenna beamwidth" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
