<Page
    x:Class="EwCalc.Views.LinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EwCalc.Helpers"
    xmlns:local="using:EwCalc.Views">

    <Page.Resources>
        <helpers:FieldErrorToBrushConverter x:Key="FieldErrorToBrush" />
        <helpers:FieldErrorToTooltipConverter x:Key="FieldErrorToTooltip" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="8">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Link budget" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="One-way link · Received power · Link margin · Effective range"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Click="CopyResultsButton_Click"
                        AutomationProperties.Name="Copy results to clipboard"
                        ToolTipService.ToolTip="Copy all results to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Copy results" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="TRANSMITTER" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="TxPowerBox"   Header="Tx power (dBm)"
                               AutomationProperties.Name="Tx power (dBm)"
                               ToolTipService.ToolTip="Transmitter output power at the antenna port"
                               Value="{x:Bind ViewModel.DefaultTxPower,   Mode=OneTime}"
                               Minimum="-50" Maximum="200" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.TxPowerError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="TxPowerBox_ValueChanged" />
                    <NumberBox x:Name="TxGainBox"    Header="Tx gain (dB)"
                               AutomationProperties.Name="Tx gain (dB)"
                               ToolTipService.ToolTip="Transmit antenna gain toward the receiver (dBi)"
                               Value="{x:Bind ViewModel.DefaultTxGain,    Mode=OneTime}"
                               Minimum="-30" Maximum="60" SmallChange="0.5"
                               BorderBrush="{x:Bind ViewModel.TxGainError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="TxGainBox_ValueChanged" />
                    <NumberBox x:Name="FrequencyBox" Header="Frequency (MHz)"
                               AutomationProperties.Name="Frequency (MHz)"
                               ToolTipService.ToolTip="Carrier frequency — used to select the propagation regime"
                               Value="{x:Bind ViewModel.DefaultFrequency, Mode=OneTime}"
                               Minimum="0.1" Maximum="100000" SmallChange="10"
                               BorderBrush="{x:Bind ViewModel.FrequencyError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="FrequencyBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="GEOMETRY" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="DistanceBox" Header="Distance (km)"
                               AutomationProperties.Name="Distance (km)"
                               ToolTipService.ToolTip="Straight-line distance between transmitter and receiver"
                               Value="{x:Bind ViewModel.DefaultDistance, Mode=OneTime}"
                               Minimum="0.01" Maximum="10000" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.DistanceError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="DistanceBox_ValueChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Grid.Column="0" x:Name="TxHeightBox" Header="Tx height (m)"
                                   AutomationProperties.Name="Tx height (m)"
                                   ToolTipService.ToolTip="Transmit antenna height above ground level"
                                   Value="{x:Bind ViewModel.DefaultTxHeight, Mode=OneTime}"
                                   Minimum="0.1" Maximum="100000" SmallChange="1"
                                   BorderBrush="{x:Bind ViewModel.TxHeightError, Mode=OneWay,
                                       Converter={StaticResource FieldErrorToBrush}}"
                                   ValueChanged="TxHeightBox_ValueChanged" />
                        <NumberBox Grid.Column="1" x:Name="RxHeightBox" Header="Rx height (m)"
                                   AutomationProperties.Name="Rx height (m)"
                                   ToolTipService.ToolTip="Receive antenna height above ground level"
                                   Value="{x:Bind ViewModel.DefaultRxHeight, Mode=OneTime}"
                                   Minimum="0.1" Maximum="100000" SmallChange="1"
                                   BorderBrush="{x:Bind ViewModel.RxHeightError, Mode=OneWay,
                                       Converter={StaticResource FieldErrorToBrush}}"
                                   ValueChanged="RxHeightBox_ValueChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="RECEIVER" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="RxGainBox" Header="Rx gain (dB)"
                               AutomationProperties.Name="Rx gain (dB)"
                               ToolTipService.ToolTip="Receive antenna gain toward the transmitter (dBi)"
                               Value="{x:Bind ViewModel.DefaultRxGain, Mode=OneTime}"
                               Minimum="-30" Maximum="60" SmallChange="0.5"
                               BorderBrush="{x:Bind ViewModel.RxGainError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="RxGainBox_ValueChanged" />
                    <NumberBox x:Name="RxSensitivityBox" Header="Rx sensitivity (dBm)"
                               AutomationProperties.Name="Rx sensitivity (dBm)"
                               ToolTipService.ToolTip="Minimum signal level the receiver can detect; the link closes when received power ≥ sensitivity"
                               Value="{x:Bind ViewModel.DefaultRxSensitivity, Mode=OneTime}"
                               Minimum="-200" Maximum="0" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.RxSensitivityError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="RxSensitivityBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="RESULTS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource ResultCardStyle}">
                <StackPanel Spacing="0">
                    <local:ResultRow Label="Received power"  Value="{x:Bind ViewModel.ReceivedPower,  Mode=OneWay}"
                                     ToolTipService.ToolTip="Signal power at the receiver input: Ptx + Gtx + Grx − path loss" />
                    <local:ResultRow Label="Path loss"       Value="{x:Bind ViewModel.PathLoss,       Mode=OneWay}"
                                     ToolTipService.ToolTip="Attenuation of the signal as it travels from transmitter to receiver" />
                    <local:ResultRow Label="Link margin"     Value="{x:Bind ViewModel.LinkMargin,     Mode=OneWay}"
                                     ToolTipService.ToolTip="Received power minus sensitivity — positive = link closed; negative = link failure" />
                    <local:ResultRow Label="Fresnel zone"    Value="{x:Bind ViewModel.FresnelZone,    Mode=OneWay}"
                                     ToolTipService.ToolTip="Range at which ground reflection begins to dominate" />
                    <local:ResultRow Label="Regime"          Value="{x:Bind ViewModel.Regime,         Mode=OneWay}"
                                     ToolTipService.ToolTip="Propagation model — free-space or two-ray — that applies at the given distance" />
                    <local:ResultRow Label="Effective range" Value="{x:Bind ViewModel.EffectiveRange, Mode=OneWay}"
                                     ToolTipService.ToolTip="Maximum range at which the link closes — where received power equals sensitivity" />
                    <local:ResultRow Label="Range regime"    Value="{x:Bind ViewModel.RangeRegime,    Mode=OneWay}"
                                     ToolTipService.ToolTip="Propagation model that limits the effective range" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
