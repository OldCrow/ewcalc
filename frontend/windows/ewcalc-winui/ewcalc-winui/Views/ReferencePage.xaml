<Page
    x:Class="EwCalc.Views.ReferencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Content is data-driven (#73): rows come from ewpresenter::refdata via
        the RefData interop wrapper and are built in ReferencePage.xaml.cs.
        This page only supplies the chrome (title/subtitle placeholders,
        filled in from the data layer's page entry at load) and the ItemHost
        panel the code-behind populates with one section header + result
        card per Section.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="8">

            <StackPanel Margin="0,0,0,8">
                <TextBlock x:Name="PageTitleBlock"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageSubtitleBlock"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel x:Name="ItemHost" Spacing="8" />

        </StackPanel>
    </ScrollViewer>
</Page>
