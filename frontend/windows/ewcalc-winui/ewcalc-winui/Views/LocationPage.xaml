<Page
    x:Class="EwCalc.Views.LocationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EwCalc.Helpers"
    xmlns:local="using:EwCalc.Views">

    <Page.Resources>
        <helpers:FieldErrorToBrushConverter x:Key="FieldErrorToBrush" />
        <helpers:FieldErrorToTooltipConverter x:Key="FieldErrorToTooltip" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="8">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Emitter location" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="CEP from AOA bearing error · TDOA timing · EEP semi-axes"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Click="CopyResultsButton_Click"
                        AutomationProperties.Name="Copy results to clipboard"
                        ToolTipService.ToolTip="Copy all results to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Copy results" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="AOA METHOD" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="BearingErrorBox" Header="RMS bearing error (°)"
                               AutomationProperties.Name="RMS bearing error (degrees)"
                               ToolTipService.ToolTip="RMS angular error of the direction-finding receivers"
                               Value="{x:Bind ViewModel.DefaultRmsBearingError, Mode=OneTime}"
                               Minimum="0.01" Maximum="45"
                               SpinButtonPlacementMode="Compact" SmallChange="0.1"
                               BorderBrush="{x:Bind ViewModel.RmsBearingError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="BearingErrorBox_ValueChanged" />
                    <NumberBox x:Name="AoaRangeBox"     Header="Range to emitter (km)"
                               AutomationProperties.Name="Range to emitter (km)"
                               ToolTipService.ToolTip="Slant range from receivers to emitter — shared by AOA and TDOA calculations"
                               Value="{x:Bind ViewModel.DefaultAoaRange, Mode=OneTime}"
                               Minimum="0.1" Maximum="10000"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.AoaRangeError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="AoaRangeBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="TDOA METHOD" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="RmsTimeErrorBox" Header="RMS timing error (ns)"
                               AutomationProperties.Name="RMS timing error (ns)"
                               ToolTipService.ToolTip="RMS TDOA measurement error — converts to a range-difference error via speed of light"
                               Value="{x:Bind ViewModel.DefaultRmsTimeError, Mode=OneTime}"
                               Minimum="0.001" Maximum="100000"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.RmsTimeError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="RmsTimeErrorBox_ValueChanged" />
                    <NumberBox x:Name="BaselineBox" Header="Receiver baseline (km)"
                               AutomationProperties.Name="Receiver baseline (km)"
                               ToolTipService.ToolTip="Receiver separation distance — wider baseline reduces CEP: CEP = c·σ_t·R / (2·B)"
                               Value="{x:Bind ViewModel.DefaultBaseline, Mode=OneTime}"
                               Minimum="0.1" Maximum="10000"
                               SpinButtonPlacementMode="Compact" SmallChange="1"
                               BorderBrush="{x:Bind ViewModel.BaselineError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="BaselineBox_ValueChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="EEP METHOD" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource InputCardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="SemiMajorBox" Header="Semi-major axis (km, 1σ)"
                               AutomationProperties.Name="Semi-major axis (km, 1 sigma)"
                               ToolTipService.ToolTip="Semi-major axis of the 1σ error ellipse (must be ≥ semi-minor)"
                               Value="{x:Bind ViewModel.DefaultSemiMajor, Mode=OneTime}"
                               Minimum="0.001" Maximum="1000"
                               SpinButtonPlacementMode="Compact" SmallChange="0.1"
                               BorderBrush="{x:Bind ViewModel.SemiMajorError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="SemiMajorBox_ValueChanged" />
                    <NumberBox x:Name="SemiMinorBox" Header="Semi-minor axis (km, 1σ)"
                               AutomationProperties.Name="Semi-minor axis (km, 1 sigma)"
                               Value="{x:Bind ViewModel.DefaultSemiMinor, Mode=OneTime}"
                               Minimum="0.001" Maximum="1000"
                               SpinButtonPlacementMode="Compact" SmallChange="0.1"
                               BorderBrush="{x:Bind ViewModel.SemiMinorError, Mode=OneWay,
                                   Converter={StaticResource FieldErrorToBrush}}"
                               ValueChanged="SemiMinorBox_ValueChanged">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind ViewModel.SemiMinorError, Mode=OneWay,
                                         Converter={StaticResource FieldErrorToTooltip},
                                         ConverterParameter='Semi-minor axis of the 1σ error ellipse (must be ≤ semi-major)'}" />
                        </ToolTipService.ToolTip>
                    </NumberBox>
                </StackPanel>
            </Border>

            <TextBlock Text="RESULTS" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource ResultCardStyle}">
                <StackPanel Spacing="0">
                    <local:ResultRow Label="CEP (AOA method)"  Value="{x:Bind ViewModel.CepAoa,  Mode=OneWay}" IsHighlighted="True"
                                     ToolTipService.ToolTip="50% Circular Error Probable from angle-of-arrival: 1.2 × range × tan(RMS error) — the radius within which 50% of location estimates fall" />
                    <local:ResultRow Label="CEP (TDOA)"        Value="{x:Bind ViewModel.CepTdoa, Mode=OneWay}" IsHighlighted="True"
                                     ToolTipService.ToolTip="50% Circular Error Probable from TDOA: c·σ_t·R / (2·B) — improves with wider baseline or shorter range" />
                    <local:ResultRow Label="CEP (EEP method)"  Value="{x:Bind ViewModel.CepEep,  Mode=OneWay}" IsHighlighted="True"
                                     ToolTipService.ToolTip="50% Circular Error Probable from the error ellipse: 0.59 × (σ_major + σ_minor), max 1% error for axis ratios down to 0.5 (Wegner Eq. 24a)" />
                </StackPanel>
            </Border>
            <Expander Header="Geometry"
                      AutomationProperties.Name="Geometry diagrams"
                      ToolTipService.ToolTip="Show or hide the geometry diagrams for this page"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <Image Source="ms-appx:///Assets/Diagrams/loc-aoa-cep.png"
                           MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center"
                           AutomationProperties.Name="loc aoa cep" />
                    <Image Source="ms-appx:///Assets/Diagrams/loc-eep-cep.png"
                           MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center"
                           AutomationProperties.Name="loc eep cep" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
