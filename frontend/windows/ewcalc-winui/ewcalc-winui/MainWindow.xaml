<Window
    x:Class="EwCalc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EwCalc"
    xmlns:views="using:EwCalc.Views"
    Title="ewcalc — EW Engineering Calculator">

    <Grid>
        <NavigationView
            x:Name="NavView"
            PaneTitle="ewcalc"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            OpenPaneLength="220"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1400">

            <NavigationView.MenuItems>

                <NavigationViewItemHeader Content="PROPAGATION" />

                <NavigationViewItem
                    x:Name="NavPropagation"
                    Tag="Propagation"
                    Content="Propagation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE704;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavAntenna"
                    Tag="Antenna"
                    Content="Antenna">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE704;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavLink"
                    Tag="Link"
                    Content="Link budget">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="ANALYSIS" />

                <NavigationViewItem
                    x:Name="NavReceiver"
                    Tag="Receiver"
                    Content="Receiver">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavJamming"
                    Tag="Jamming"
                    Content="Jamming">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavLocation"
                    Tag="Location"
                    Content="Location">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavRadar"
                    Tag="Radar"
                    Content="Radar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavDetection"
                    Tag="Detection"
                    Content="Detection">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavDoppler"
                    Tag="Doppler"
                    Content="Doppler &amp; Resolution">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavDigital"
                    Tag="Digital"
                    Content="Digital / DSSS">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--
                    The REFERENCE separator/header and one item per refdata
                    page (#74) are built in code (MainWindow.xaml.cs,
                    BuildReferenceNavItems) — the page list is enumerated
                    from ewpresenter::refdata::pages() at startup via the
                    RefData interop wrapper, so a new data-layer page becomes
                    a nav entry with no XAML change.
                -->

            </NavigationView.MenuItems>

            <!-- No FooterMenuItems — IsSettingsVisible=False removes the built-in one -->

            <NavigationView.PaneFooter>
                <Button x:Name="ResetInputsButton"
                        Content="Reset saved inputs"
                        Click="ResetInputsButton_Click"
                        AutomationProperties.Name="Reset saved inputs to defaults"
                        Margin="12,8"
                        HorizontalAlignment="Stretch" />
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />

        </NavigationView>
    </Grid>
</Window>
